# Worker OAuth client secret (must match OIDC_WORKER_CLIENT_SECRET on the API side)
WORKER_CLIENT_SECRET=

# RabbitMQ credentials (defaults match the API compose)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Silo (MinIO-compatible) root credentials for the local demo (never commit real values)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
